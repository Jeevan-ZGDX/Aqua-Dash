# ------------------------------------------------------------------
# CSE Admissions Analytics Dashboard - Environment Template
# ------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Generate a strong JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ------------------------------------------------------------------

# Application
APP_NAME=CSE Admissions Analytics Dashboard
APP_ENV=development          # development | testing | production
APP_DEBUG=true               # MUST be false when APP_ENV=production
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Kolkata

# Interactive API docs (/docs, /redoc, /openapi.json).
# Defaults to off in production; set true only if you intend to expose them.
ENABLE_DOCS=true

# Database
# Supabase/PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SQLite fallback for local development / tests:
DATABASE_URL=sqlite+aiosqlite:///./cse_admissions.db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# JWT — REQUIRED. Must be >= 32 chars. Never reuse across environments.
JWT_SECRET_KEY=replace-me-with-a-64-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=cse-admissions-analytics-dashboard
JWT_AUDIENCE=nextjs-frontend

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# ALLOWED_HOSTS must be an explicit list in production ("*" is rejected there).
ALLOWED_HOSTS=["*"]
COOKIE_SECURE=false          # MUST be true when APP_ENV=production (HTTPS only)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=null

# Rate limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
GENERAL_RATE_LIMIT=120/minute

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=120
# Required in production for a shared JWT revocation denylist across workers.
REDIS_URL=null

# Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMPORT_EXTENSIONS=[".csv",".xlsx"]
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf",".jpg",".jpeg",".png"]

# Admin bootstrap — the default password is rejected in production.
ADMIN_EMAIL=admin@cse.edu
ADMIN_USERNAME=admin
ADMIN_NAME=Department Administrator
ADMIN_PASSWORD=replace-me-before-first-boot
